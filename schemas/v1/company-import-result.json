{
  "$defs": {
    "Address": {
      "additionalProperties": false,
      "properties": {
        "country_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country Code"
        },
        "postcode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Postcode"
        },
        "locality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locality"
        },
        "street": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Street"
        },
        "house_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "House Number"
        },
        "native_names": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Native Names",
          "type": "object"
        }
      },
      "title": "Address",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "reference_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Period"
        },
        "valid_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Period"
        },
        "method_version": {
          "minLength": 1,
          "title": "Method Version",
          "type": "string"
        },
        "rights": {
          "$ref": "#/$defs/Rights"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        }
      },
      "required": [
        "id",
        "source_id",
        "source_type",
        "source_ref",
        "retrieved_at",
        "method_version",
        "rights",
        "quality"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ImportedCompanySite": {
      "additionalProperties": false,
      "description": "Source assertions only; role never inferred from address or company name.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "site_role": {
          "enum": [
            "unknown",
            "registered_address",
            "headquarters",
            "branch",
            "operating_site"
          ],
          "title": "Site Role",
          "type": "string"
        },
        "point": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "legal_entity_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Entity Ref"
        },
        "industry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Industry"
        },
        "workforce": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkforceFact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source_id",
        "source_ref",
        "site_role",
        "evidence_ids"
      ],
      "title": "ImportedCompanySite",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message_key": {
          "title": "Message Key",
          "type": "string"
        },
        "safe_params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Safe Params",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message_key"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Permission": {
      "enum": [
        "allowed",
        "denied",
        "unknown"
      ],
      "title": "Permission",
      "type": "string"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "longitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "ge": -180,
          "le": 180,
          "title": "Longitude"
        },
        "latitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "ge": -90,
          "le": 90,
          "title": "Latitude"
        }
      },
      "required": [
        "longitude",
        "latitude"
      ],
      "title": "Point",
      "type": "object"
    },
    "Quality": {
      "additionalProperties": false,
      "properties": {
        "precision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision"
        },
        "coverage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage"
        },
        "freshness": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freshness"
        },
        "source_reliability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reliability"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        },
        "verification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification"
        }
      },
      "title": "Quality",
      "type": "object"
    },
    "RequestContext": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "location_versions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Location Versions",
          "type": "object"
        },
        "effective_conditions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Effective Conditions",
          "type": "object"
        },
        "profile_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Ref"
        },
        "template_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Ref"
        },
        "method_version": {
          "default": "manual-v1",
          "title": "Method Version",
          "type": "string"
        },
        "scope_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Token"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "RequestContext",
      "type": "object"
    },
    "Rights": {
      "additionalProperties": false,
      "properties": {
        "use": {
          "$ref": "#/$defs/Permission",
          "default": "unknown"
        },
        "retain": {
          "$ref": "#/$defs/Permission",
          "default": "unknown"
        },
        "cache": {
          "$ref": "#/$defs/Permission",
          "default": "unknown"
        },
        "display": {
          "$ref": "#/$defs/Permission",
          "default": "unknown"
        },
        "export": {
          "$ref": "#/$defs/Permission",
          "default": "unknown"
        },
        "redistribute": {
          "$ref": "#/$defs/Permission",
          "default": "unknown"
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "license_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Url"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "permitted_purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permitted Purpose"
        }
      },
      "title": "Rights",
      "type": "object"
    },
    "Status": {
      "enum": [
        "ok",
        "partial",
        "no_results",
        "not_collected",
        "disabled",
        "unconfigured",
        "unsupported",
        "unavailable",
        "rate_limited",
        "invalid_input",
        "conflict",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    },
    "WorkforceFact": {
      "additionalProperties": false,
      "description": "One explicitly scoped source claim; no allocation or midpoint inference.",
      "properties": {
        "scope": {
          "enum": [
            "site",
            "legal_entity"
          ],
          "title": "Scope",
          "type": "string"
        },
        "count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "lower": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        }
      },
      "required": [
        "scope"
      ],
      "title": "WorkforceFact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "data": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ImportedCompanySite"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Data"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "context": {
      "$ref": "#/$defs/RequestContext"
    }
  },
  "required": [
    "status",
    "data",
    "context"
  ],
  "title": "Result[tuple[ImportedCompanySite, ...]]",
  "type": "object"
}
